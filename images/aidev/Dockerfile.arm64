FROM ubuntu:24.04

SHELL ["/bin/bash", "-o", "pipefail", "-c"]
ENV DEBIAN_FRONTEND=noninteractive

# Core apt packages
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    git \
    build-essential \
    openssh-client \
    pkg-config \
    libssl-dev \
    unzip \
    locales \
    tzdata \
    telnet \
    sudo \
  && rm -rf /var/lib/apt/lists/*

# Locale
RUN sed -i 's/# en_US.UTF-8 UTF-8/en_US.UTF-8 UTF-8/' /etc/locale.gen \
  && locale-gen \
  && update-locale LANG=en_US.UTF-8 LC_ALL=en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LC_ALL=en_US.UTF-8
ENV TZ=UTC
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone

# Create user eks with sudo privileges
RUN useradd -m -s /bin/bash eks \
  && echo 'eks ALL=(ALL) NOPASSWD:ALL' >> /etc/sudoers

# Tools via apt (replaces Brewfile for arm64)
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    tmux \
    ripgrep \
    fd-find \
    tree \
    vim \
    git-lfs \
  && rm -rf /var/lib/apt/lists/* \
  && ln -sf /usr/bin/fdfind /usr/bin/fd

# git-delta (from GitHub Releases)
RUN curl -fsSL https://github.com/dandavison/delta/releases/latest/download/git-delta_0.18.2_arm64.deb -o /tmp/git-delta.deb \
  && dpkg -i /tmp/git-delta.deb \
  && rm /tmp/git-delta.deb

# Switch to eks user
USER eks

# oh-my-bash
RUN bash -c "$(curl -fsSL https://raw.githubusercontent.com/ohmybash/oh-my-bash/master/tools/install.sh)" || true
RUN sed -i 's/^OSH_THEME=.*/OSH_THEME="brainy"/' /home/eks/.bashrc

RUN echo 'source /home/eks/.bashrcx' >> /home/eks/.bashrc

COPY --chown=eks:eks .tmux.conf /home/eks/.tmux.conf

# mise (official installer)
RUN curl https://mise.run | sh
ENV PATH="/home/eks/.local/bin:${PATH}"

# zoxide (via mise)
RUN mise use -g zoxide@latest

# Git LFS
RUN git lfs install

# node / npm / npx / pnpm (official binary, user-space)
ENV NODE_VERSION=24
RUN curl -fsSL https://nodejs.org/dist/latest-v${NODE_VERSION}.x/SHASUMS256.txt -o /tmp/SHASUMS256.txt \
  && NODE_TAR=$(grep 'linux-arm64.tar.xz' /tmp/SHASUMS256.txt | awk '{print $2}') \
  && curl -fsSL "https://nodejs.org/dist/latest-v${NODE_VERSION}.x/${NODE_TAR}" -o /tmp/node.tar.xz \
  && mkdir -p /home/eks/.local/node \
  && tar -xJf /tmp/node.tar.xz --strip-components=1 -C /home/eks/.local/node \
  && rm /tmp/node.tar.xz /tmp/SHASUMS256.txt
ENV PATH="/home/eks/.local/node/bin:${PATH}"
RUN npm install -g pnpm@latest

# uv / uvx
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/home/eks/.local/bin:${PATH}"

# bun / bunx
RUN curl -fsSL https://bun.com/install | bash
ENV PATH="/home/eks/.bun/bin:${PATH}"

# rustup (official installer)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | bash -s -- -y
ENV PATH="/home/eks/.cargo/bin:${PATH}"

# AI tools
RUN curl -fsSL https://claude.ai/install.sh | bash
RUN npm i -g @openai/codex

WORKDIR /home/eks
CMD ["bash"]
