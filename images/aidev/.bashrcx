# Use Emacs keybindings
set -o emacs

# History search with Ctrl-R (reverse search)
# Ctrl-S for forward search (may need to disable terminal flow control)
stty -ixon

# Better history search with arrow keys
bind '"\e[A": history-search-backward'
bind '"\e[B": history-search-forward'

# Git aliases
alias gst="git status"
alias gd="git diff"
alias gds="git diff --staged"
alias ga="git add -A"
alias gco="git checkout "
alias gb="git branch"
alias gw="git worktree"

# eval "$(zoxide init bash)"
# source ~/.profile

# mise (project toolchain)
if command -v mise >/dev/null 2>&1; then
  eval "$(mise activate bash)"
fi

export LANG=en_US.UTF-8
export LC_ALL=en_US.UTF-8

# mise sops variables
export CONTEXT_SOPS_AGE_KEY_FILE=/Users/mr00325ml/context/configs/age/context.txt
export CONTEXT_ROPS_AGE_KEY_FILE=/Users/mr00325ml/context/configs/age/context.txt
export CONTEXT_ROPS_CONFIG_FILE=/Users/mr00325ml/context/configs/rops/rops.toml